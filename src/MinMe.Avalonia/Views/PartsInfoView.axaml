<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MinMe.Avalonia.ViewModels;assembly=MinMe.Avalonia"
             xmlns:model="clr-namespace:MinMe.Avalonia.Models;assembly=MinMe.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="250"
             x:Class="MinMe.Avalonia.Views.PartsInfoView"
             x:DataType="vm:PartsInfoViewModel">
  <DataGrid Margin="10" ItemsSource="{Binding Parts}">
    <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{ReflectionBinding Name}" Width="Auto"/>
      <DataGridTemplateColumn Header="Size (bytes)" Width="Auto" SortMemberPath="Size">
        <DataGridTemplateColumn.CellTemplate>
          <DataTemplate x:DataType="model:PartInfoRow">
            <ContentControl Content="{Binding Converter={StaticResource sizeConverter}}"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
          </DataTemplate>
        </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="Used from" Binding="{ReflectionBinding Usage}" Width="*"/>
      <DataGridTextColumn Header="Content Type" Binding="{ReflectionBinding ContentType}" Width="Auto"/>
    </DataGrid.Columns>
  </DataGrid>
</UserControl>
