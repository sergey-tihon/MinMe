<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:MinMe.Avalonia.ViewModels;assembly=MinMe.Avalonia"
             mc:Ignorable="d"
             d:DesignWidth="1100"
             d:DesignHeight="96"
             x:Class="MinMe.Avalonia.Views.ActionsPanelView"
             x:DataType="vm:ActionsPanelViewModel">
  <UserControl.Styles>
    <Style Selector="Menu.Toolbar > MenuItem ContentControl#PART_IconPresenter">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="MaxWidth" Value="34" />
      <Setter Property="MaxHeight" Value="34" />
    </Style>
    <Style Selector="Menu.Toolbar > MenuItem ContentPresenter#PART_HeaderPresenter.TopLevelMenuItem">
      <Setter Property="MinWidth" Value="72" />
      <Setter Property="MaxWidth" Value="100" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>

  <Border BorderBrush="{DynamicResource LayoutBorderMidBrush}"
          BorderThickness="0,0,0,1"
          Padding="{Binding $parent[Window].WindowDecorationMargin}"
          Background="Transparent">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto"
          MinHeight="92">
      <Menu Grid.Column="0"
            Classes="MacOS_Theme_MenuLabelBelowIcon Toolbar"
            VerticalAlignment="Center">
        <MenuItem Header="Open"
                  Command="{Binding OpenCommand}"
                  ToolTip.Tip="Open a PowerPoint presentation">
          <MenuItem.Icon>
            <PathIcon Data="M1.5 3.5C1.5 2.39543 2.39543 1.5 3.5 1.5H6.29289C6.82333 1.5 7.33204 1.71071 7.70711 2.08579L8.91421 3.29289C9.10175 3.48043 9.35811 3.58579 9.62541 3.58579H12.5C13.6046 3.58579 14.5 4.48122 14.5 5.58579V12.5C14.5 13.6046 13.6046 14.5 12.5 14.5H3.5C2.39543 14.5 1.5 13.6046 1.5 12.5V3.5Z"
                     Width="32"
                     Height="32" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Publish"
                  Command="{Binding PublishCommand}"
                  ToolTip.Tip="Publish slides as images">
          <MenuItem.Icon>
            <PathIcon Data="M3 2C3 1.44772 3.44772 1 4 1H9L13 5V14C13 14.5523 12.5523 15 12 15H4C3.44772 15 3 14.5523 3 14V2ZM9 1V5H13M7 9H12M12 9L10 7M12 9L10 11"
                     Width="32"
                     Height="32" />
          </MenuItem.Icon>
        </MenuItem>
        <MenuItem Header="Optimize"
                  Command="{Binding OptimizeCommand}"
                  ToolTip.Tip="Save an optimized presentation">
          <MenuItem.Icon>
            <PathIcon Data="M8 1C8.55228 1 9 1.44772 9 2V3.07089C9.64428 3.18289 10.249 3.40193 10.7942 3.71121L11.5523 2.95312C11.9428 2.5626 12.576 2.5626 12.9665 2.95312L13.0469 3.03353C13.4374 3.42405 13.4374 4.05722 13.0469 4.44774L12.2888 5.20583C12.5981 5.75101 12.8171 6.35572 12.9291 7H14C14.5523 7 15 7.44772 15 8C15 8.55228 14.5523 9 14 9H12.9291C12.8171 9.64428 12.5981 10.249 12.2888 10.7942L13.0469 11.5523C13.4374 11.9428 13.4374 12.576 13.0469 12.9665L12.9665 13.0469C12.576 13.4374 11.9428 13.4374 11.5523 13.0469L10.7942 12.2888C10.249 12.5981 9.64428 12.8171 9 12.9291V14C9 14.55228 8.55228 15 8 15C7.44772 15 7 14.55228 7 14V12.9291C6.35572 12.8171 5.75101 12.5981 5.20583 12.2888L4.44774 13.0469C4.05722 13.4374 3.42405 13.4374 3.03353 13.0469L2.95312 12.9665C2.5626 12.576 2.5626 11.9428 2.95312 11.5523L3.71121 10.7942C3.40193 10.249 3.18289 9.64428 3.07089 9H2C1.44772 9 1 8.55228 1 8C1 7.44772 1.44772 7 2 7H3.07089C3.18289 6.35572 3.40193 5.75101 3.71121 5.20583L2.95312 4.44774C2.5626 4.05722 2.5626 3.42405 2.95312 3.03353L3.03353 2.95312C3.42405 2.5626 4.05722 2.5626 4.44774 2.95312L5.20583 3.71121C5.75101 3.40193 6.35572 3.18289 7 3.07089V2C7 1.44772 7.44772 1 8 1ZM8 10.5C9.38071 10.5 10.5 9.38071 10.5 8C10.5 6.61929 9.38071 5.5 8 5.5C6.61929 5.5 5.5 6.61929 5.5 8C5.5 9.38071 6.61929 10.5 8 10.5Z"
                     Width="32"
                     Height="32" />
          </MenuItem.Icon>
        </MenuItem>
      </Menu>

      <Border Grid.Column="1"
              Width="1"
              Margin="18,22,18,22"
              Background="{DynamicResource LayoutBorderMidBrush}" />

      <StackPanel Grid.Column="2"
                  Orientation="Horizontal"
                  VerticalAlignment="Center"
                  Spacing="8">
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <TextBlock Text="Output resolution"
                     FontSize="12"
                     Opacity="0.7" />
          <ComboBox ItemsSource="{Binding PublishModes}"
                    SelectedItem="{Binding SelectedMode}"
                    Width="155"
                    HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>

      <Border Grid.Column="3"
              Margin="20,0,12,0"
              Padding="10,6"
              CornerRadius="9"
              BorderBrush="{DynamicResource LayoutBorderMidBrush}"
              BorderThickness="1"
              VerticalAlignment="Center"
              HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal"
                    Spacing="7">
          <Ellipse Width="8"
                   Height="8"
                   Fill="#34C759"
                   VerticalAlignment="Center" />
          <TextBlock Text="Ready"
                     FontSize="12"
                     Opacity="0.78" />
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>
